
# --- Local --- Gardez localhost pour les URLs publiques tant que vous développez sur la machine.
# --- Prod --- Sur le serveur : ajoutez « prod » au profil et utilisez https://mangafric.com (voir section plus bas).

# Local : postgres seul. Production typique : postgres,prod (profil prod → URLs domaine)
SPRING_PROFILES_ACTIVE=postgres
DATABASE_URL=postgresql://mangafriq:mangafriq@localhost:5432/mangafriq

# JWT (must be stable across restarts)
APP_JWT_SECRET=
APP_JWT_REQUIRE_SECRET=true

# Realtime broker relay (RabbitMQ STOMP) for horizontal scaling
# Requires RabbitMQ plugin: rabbitmq_stomp
# Default STOMP port is 61613.
APP_REALTIME_RELAY_HOST=localhost
APP_REALTIME_RELAY_PORT=61613
APP_REALTIME_RELAY_LOGIN=myuser
APP_REALTIME_RELAY_PASSCODE=secret

# Backend-served creator contract logo (used in creator contract PDF/email)
# Point it to the creator panel logo on disk, e.g.:
#   ..\\..\\creator-panel\\public\\creator-panel.png
APP_CREATOR_PANEL_LOGO_PATH=

# Public URLs (contrats, emails, liens)
# --- Développement local ---
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_PUBLIC_API_BASE_URL=http://localhost:8088
# Logo PNG pour les emails HTML (vide = même origine que APP_PUBLIC_BASE_URL + /magafrik-logo.png)
APP_EMAIL_LOGO_URL=
# Optional : URL du panneau créateur (liens dans les emails modération / publication)
APP_CREATOR_PANEL_URL=

# --- Production (domaine MangAfric.com) — décommentez et adaptez ---
# SPRING_PROFILES_ACTIVE=postgres,prod
# APP_PUBLIC_BASE_URL=https://mangafric.com
# Si l’API est sur le même domaine (reverse proxy /api/v1) :
# APP_PUBLIC_API_BASE_URL=https://mangafric.com
# Si l’API est sur un sous-domaine :
# APP_PUBLIC_API_BASE_URL=https://api.mangafric.com

# Cloudflare R2 (S3-compatible)
# R2 endpoint format:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
