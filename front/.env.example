## Front (Vite)
# Local
VITE_API_BASE_URL=http://localhost:8088/api/v1
VITE_API_BASE_URL_DEFAULT=http://localhost:8088/api/v1

# Production — MangAfriq.com (choisissez selon votre reverse proxy)
# Même hôte, API en /api/v1 :
# VITE_API_BASE_URL=https://mangafriq.com/api/v1
# VITE_API_BASE_URL_DEFAULT=https://mangafriq.com/api/v1
# API sur sous-domaine :
# VITE_API_BASE_URL=https://api.mangafriq.com/api/v1
# VITE_API_BASE_URL_DEFAULT=https://api.mangafriq.com/api/v1

# Session key shared across apps
VITE_SESSION_STORAGE_KEY=MangAfriq_session

# Optional cross-app links
# VITE_CREATOR_PANEL_URL=https://…

